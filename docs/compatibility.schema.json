{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mykola-melnik/openspec-workbench/main/docs/compatibility.schema.json",
  "title": "OpenSpec Workbench compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "application", "openspec", "standards", "unknownFormatPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "application": { "type": "string" },
    "openspec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "adapters"],
      "properties": {
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.x$" }
        },
        "adapters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenanceFile", "required"],
      "properties": {
        "provenanceFile": { "type": "string", "minLength": 1 },
        "required": { "const": false }
      }
    },
    "unknownFormatPolicy": { "const": "fail-closed" }
  }
}
